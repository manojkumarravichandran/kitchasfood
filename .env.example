# Copy this file to .env and fill in your own Supabase project's values.
# Find both on the Supabase dashboard: Project Settings -> Data API (and API Keys).
# The anon key is safe to ship in the browser bundle — it only grants whatever
# your Row Level Security policies allow. Never put the service_role key here.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
